[Unit]
Description=Virtioso stream multiplexer daemon
Documentation=https://github.com/virtioso/virtioso-muxd
After=local-fs.target
# Stopped by default; started explicitly by Autopilot chain or other tooling.
# Override VIRTIOSO_MUX_SINK in a drop-in for target-specific configuration.

[Service]
Type=simple
Environment=VIRTIOSO_MUX_SINK=uart:/dev/ttyS1
RuntimeDirectory=virtioso-mux
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/virtioso-muxd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
