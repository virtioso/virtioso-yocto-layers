--- /dev/null
+++ b/drivers/platform/sel4/hyp-ftrace.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * seL4 Hypervisor Ftrace Control Driver
+ *
+ * Provides interface to arm/dump seL4 kernel ftrace from guest Linux.
+ * The driver maps a memory region that, when written to, causes the VMM
+ * to intercept the access and forward commands to the seL4 kernel.
+ *
+ * Uses postcore_initcall to initialize early, before complex drivers
+ * like BPMP, allowing ftrace to capture early boot activity.
+ *
+ * Copyright 2024, Unikie
+ */
+
+#include <linux/io.h>
+#include <linux/printk.h>
+#include <linux/hyp-ftrace.h>
+
+/* MMIO address configured in seL4 VMM */
+#define HYP_FTRACE_BASE		0x0F010000UL
+#define HYP_FTRACE_SIZE		0x1000
+
+/* Register offsets */
+#define HYP_FTRACE_CMD		0x00
+#define HYP_FTRACE_STATUS	0x04
+
+/* Commands */
+#define CMD_ARM		0x01
+#define CMD_DUMP	0x02
+
+static void __iomem *hyp_ftrace_base;
+static bool hyp_ftrace_available;
+
+/**
+ * hyp_ftrace_arm - Reset seL4 ftrace buffer and enable recording
+ *
+ * Call this to clear the ftrace buffer and start fresh recording.
+ * Typically called at a known point before the activity to trace.
+ */
+void hyp_ftrace_arm(void)
+{
+	if (!hyp_ftrace_available) {
+		pr_debug("hyp_ftrace: not available\n");
+		return;
+	}
+	pr_info("hyp_ftrace: arming\n");
+	writel_relaxed(CMD_ARM, hyp_ftrace_base + HYP_FTRACE_CMD);
+}
+EXPORT_SYMBOL_GPL(hyp_ftrace_arm);
+
+/**
+ * hyp_ftrace_dump - Trigger ftrace buffer dump to UART
+ *
+ * Call this to dump the ftrace buffer contents to the seL4 console.
+ */
+void hyp_ftrace_dump(void)
+{
+	if (!hyp_ftrace_available) {
+		pr_debug("hyp_ftrace: not available\n");
+		return;
+	}
+	pr_info("hyp_ftrace: dumping\n");
+	writel_relaxed(CMD_DUMP, hyp_ftrace_base + HYP_FTRACE_CMD);
+}
+EXPORT_SYMBOL_GPL(hyp_ftrace_dump);
+
+/**
+ * hyp_ftrace_available - Check if hyp_ftrace interface is available
+ */
+bool hyp_ftrace_is_available(void)
+{
+	return hyp_ftrace_available;
+}
+EXPORT_SYMBOL_GPL(hyp_ftrace_is_available);
+
+static int __init hyp_ftrace_init(void)
+{
+	/*
+	 * Try to map the hyp_ftrace MMIO region. If running under seL4
+	 * with hyp_ftrace configured, the VMM will handle accesses.
+	 * If not under seL4, ioremap may fail or accesses will fault.
+	 *
+	 * We use ioremap (not ioremap_np) since the VMM expects normal
+	 * memory-mapped accesses that trigger stage 2 faults.
+	 */
+	hyp_ftrace_base = ioremap(HYP_FTRACE_BASE, HYP_FTRACE_SIZE);
+	if (!hyp_ftrace_base) {
+		pr_info("hyp_ftrace: ioremap failed, not available\n");
+		return 0; /* Not an error - just not running under seL4 */
+	}
+
+	hyp_ftrace_available = true;
+	pr_info("hyp_ftrace: initialized at 0x%lx\n", HYP_FTRACE_BASE);
+
+	/*
+	 * Auto-arm ftrace to capture early boot activity.
+	 * This resets the seL4 ftrace buffer and starts recording.
+	 */
+	hyp_ftrace_arm();
+
+	return 0;
+}
+
+/*
+ * Use postcore_initcall to run early, before device_initcall drivers
+ * like BPMP. This ensures ftrace is armed before interesting activity.
+ */
+postcore_initcall(hyp_ftrace_init);
diff --git a/include/linux/hyp-ftrace.h b/include/linux/hyp-ftrace.h
new file mode 100644
index 000000000..e2b5c8a12
--- /dev/null
+++ b/include/linux/hyp-ftrace.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * seL4 Hypervisor Ftrace Control Interface
+ *
+ * Copyright 2024, Unikie
+ */
+
+#ifndef _LINUX_HYP_FTRACE_H
+#define _LINUX_HYP_FTRACE_H
+
+#ifdef CONFIG_SEL4_HYP_FTRACE
+void hyp_ftrace_arm(void);
+void hyp_ftrace_dump(void);
+bool hyp_ftrace_is_available(void);
+#else
+static inline void hyp_ftrace_arm(void) {}
+static inline void hyp_ftrace_dump(void) {}
+static inline bool hyp_ftrace_is_available(void) { return false; }
+#endif
+
+#endif /* _LINUX_HYP_FTRACE_H */
+
