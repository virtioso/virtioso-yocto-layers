 drivers/platform/Makefile          |   1 +
 drivers/platform/sel4/Kconfig      |  14 ++++
 drivers/platform/sel4/Makefile     |   1 +
 drivers/platform/sel4/hyp-ftrace.c | 108 +++++++++++++++++++++++++++++
 include/linux/hyp-ftrace.h         |  22 ++++++
 6 files changed, 148 insertions(+)
 create mode 100644 drivers/platform/sel4/Kconfig
 create mode 100644 drivers/platform/sel4/Makefile
 create mode 100644 drivers/platform/sel4/hyp-ftrace.c
