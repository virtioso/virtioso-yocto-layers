From f75db96950750df4f71815639d4c98fc7e0b41e6 Mon Sep 17 00:00:00 2001
From: Hannu Lyytinen <hannux@ssrc.tii.ae>
Date: Tue, 28 Feb 2023 01:38:38 +0200
Subject: [PATCH] Do not load DTB on seL4 guest
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This would break SWIOTLB boot.

Upstream-Status: Inappropriate [sel4 specific]

Signed-off-by: Hannu Lyytinen <hannux@ssrc.tii.ae>
Signed-off-by: Markku Ahvenjärvi <markku.ahvenjarvi@unikie.com>
---
 hw/arm/boot.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/hw/arm/boot.c b/hw/arm/boot.c
index 84ea6a807a..aa9a25f5b0 100644
--- a/hw/arm/boot.c
+++ b/hw/arm/boot.c
@@ -16,6 +16,7 @@
 #include "hw/arm/linux-boot-if.h"
 #include "sysemu/kvm.h"
 #include "sysemu/tcg.h"
+#include "sysemu/sel4.h"
 #include "sysemu/sysemu.h"
 #include "sysemu/numa.h"
 #include "hw/boards.h"
@@ -522,6 +523,10 @@ int arm_load_dtb(hwaddr addr, const struct arm_boot_info *binfo,
     char **node_path;
     Error *err = NULL;
 
+    if (sel4_enabled()) {
+        return 0;
+    }
+
     if (binfo->dtb_filename) {
         char *filename;
         filename = qemu_find_file(QEMU_FILE_TYPE_BIOS, binfo->dtb_filename);
