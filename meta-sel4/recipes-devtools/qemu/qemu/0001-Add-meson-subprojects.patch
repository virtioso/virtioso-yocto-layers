+def vfu_run_ctx(ctx, expect=0):
+    ret = lib.vfu_run_ctx(ctx)
+    if expect == 0:
+        assert ret >= 0, "vfu_run_ctx(): %s" % os.strerror(c.get_errno())
+    else:
+        assert ret == -1
+        assert c.get_errno() == expect
+    return ret
