+            exactCode
+        );
+    } else {
+        for (
+            functionCode = 1; functionCode < NUM_FUNCTIONS; ++functionCode
+        ) {
+            if (
+                ! numOperands
+                    || (functionInfos[functionCode].attribs
+                            & ((numOperands == 1) ? FUNC_ARG_UNARY
+                                   : FUNC_ARG_BINARY))
+            ) {
+                timeFunction(
+                    functionCode,
+                    roundingPrecision,
+                    roundingCode,
+                    tininessCode,
+                    exactCode
+                );
+            }
+        }
+    }
+    return EXIT_SUCCESS;
+
+}
