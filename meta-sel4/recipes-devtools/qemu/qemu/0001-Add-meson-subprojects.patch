+        if ( yPtr->isInf || xPtr->isZero ) return true;
+        if ( xPtr->isInf || yPtr->isZero ) return false;
+        if ( xPtr->exp < yPtr->exp ) return true;
+        if ( yPtr->exp < xPtr->exp ) return false;
