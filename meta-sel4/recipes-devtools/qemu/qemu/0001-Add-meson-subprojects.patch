+            genCases_ui64_a = ui64NextP1( &sequenceA );
+            genCases_done = sequenceA.done;
+            subcase = -1;
+            break;
+        }
+    } else {
+        switch ( subcase ) {
+         case 0:
+            genCases_ui64_a = ui64RandomP3();
+            break;
+         case 2:
+            genCases_ui64_a = ui64RandomPInf();
+            break;
+         case 3:
+            subcase = -1;
+         case 1:
+            genCases_ui64_a = ui64NextP2( &sequenceA );
+            genCases_done = sequenceA.done;
+            break;
+        }
+    }
+    ++subcase;
+
+}
