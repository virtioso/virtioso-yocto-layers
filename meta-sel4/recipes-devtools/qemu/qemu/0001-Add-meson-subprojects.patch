index 0000000000000000000000000000000000000000..846da9a4960dc56ec1a27d9dd35855626e258a2d
--- /dev/null
+++ b/subprojects/slirp/src/ncsi.c
@@ -0,0 +1,326 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * NC-SI (Network Controller Sideband Interface) "echo" model
+ *
+ * Copyright (C) 2016-2018 IBM Corp.
