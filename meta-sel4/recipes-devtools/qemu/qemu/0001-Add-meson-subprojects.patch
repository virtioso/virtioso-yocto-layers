+pci_config_space_ptr(vfu_ctx_t *vfu_ctx, loff_t offset)
+{
+    assert((size_t)offset < pci_config_space_size(vfu_ctx));
+    return (uint8_t *)vfu_ctx->pci.config_space + offset;
+}
