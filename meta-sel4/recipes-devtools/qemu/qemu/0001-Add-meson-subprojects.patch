+#include <stdarg.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include "platform.h"
+#include "fail.h"
+
+const char *fail_programName = "";
+
+void fail( const char *messagePtr, ... )
+{
+    va_list varArgs;
+
+    fflush( 0 );
+    fprintf( stderr, "%s: ", fail_programName );
+    va_start( varArgs, messagePtr );
+    vfprintf( stderr, messagePtr, varArgs );
+    va_end( varArgs );
+    fputs( ".\n", stderr );
+    exit( EXIT_FAILURE );
+
+}
