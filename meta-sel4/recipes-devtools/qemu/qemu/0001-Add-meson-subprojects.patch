+def ext_cap_hdr(buf, offset):
+    """Read an extended cap header."""
+
+    # struct pcie_ext_cap_hdr
+    cap_id, cap_next = struct.unpack_from('HH', buf, offset)
+    cap_next >>= 4
+    return cap_id, cap_next
