+/*
+ * gpio-pci-idio-16: a simple example server identifying as a GPIO PCI device.
+ */
+
+#include <stdio.h>
+#include <err.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <string.h>
+#include <signal.h>
+#include <errno.h>
+#include <assert.h>
