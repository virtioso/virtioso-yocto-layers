+static vfu_msg_t *
+mkmsg(enum vfio_user_command cmd, void *data, size_t size)
+{
+    msg.hdr.cmd = cmd;
+    msg.hdr.msg_size = size;
+    msg.in.iov.iov_base = data;
+    msg.in.iov.iov_len = size;
+
+    if (nr_fds != 0) {
+        msg.in.fds = fds;
+        msg.in.nr_fds = nr_fds;
+    } else {
+        msg.in.fds = NULL;
+        msg.in.nr_fds = 0;
+    }
+
+    return &msg;
+}
