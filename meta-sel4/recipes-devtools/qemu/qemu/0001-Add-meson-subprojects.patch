+        xPtr->sig = add128( xPtr->sig, sigY );
+    }
+    if ( xPtr->sig.v64 & UINT64_C( 0x8000000000000000 ) ) {
+        xPtr->sign = !xPtr->sign;
+        xPtr->sig = neg128( xPtr->sig );
+    }
+    return;
+ copyY:
+    *xPtr = *yPtr;
+
+}
