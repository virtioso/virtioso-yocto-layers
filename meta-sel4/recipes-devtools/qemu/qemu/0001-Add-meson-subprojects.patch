+struct pxcaps {
+    uint16_t ver:4;
+    uint16_t dpt:4;
+    uint16_t si:1;
+    uint16_t imn:5;
+    uint16_t res1:2;
+} __attribute__((packed));
+_Static_assert(sizeof(struct pxcaps) == 0x2, "bad PXCAPS size");
+
+struct pxdcap {
+    uint32_t mps:3;
+    uint32_t pfs:2;
+    uint32_t etfs:1;
+    uint32_t l0sl:3;
+    uint32_t l1l:3;
