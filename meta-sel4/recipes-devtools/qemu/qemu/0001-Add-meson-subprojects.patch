+@vfu_region_access_cb_t
+def pci_region_cb(ctx, buf, count, offset, is_write):
+    if not is_write:
+        return read_pci_cfg_space(ctx, buf, count, offset, extended=True)
+
+    return write_pci_cfg_space(ctx, buf, count, offset, extended=True)
