+} __attribute__((packed));
+_Static_assert(sizeof(struct pxrs) == 0x4, "bad PXRS size");
+
+struct pxdcap2 {
+    uint32_t ctrs:4;
+    uint32_t ctds:1;
+    uint32_t arifs:1;
+    uint32_t aors:1;
+    uint32_t aocs32:1;
+    uint32_t aocs64:1;
+    uint32_t ccs128:1;
+    uint32_t nprpr:1;
+    uint32_t ltrs:1;
+    uint32_t tphcs:2;
+    uint32_t obffs:2;
+    uint32_t effs:1;
+    uint32_t eetps:1;
+    uint32_t meetp:2;
+    uint32_t res1:8;
+} __attribute__((packed));
