+def vfu_attach_ctx(ctx, expect=0):
+    ret = lib.vfu_attach_ctx(ctx)
+    if expect == 0:
+        assert ret == 0, "failed to attach: %s" % os.strerror(c.get_errno())
+    else:
+        assert ret == -1
+        assert c.get_errno() == expect
+    return ret
+
