+def test_dma_unmap_short_write():
+    payload = struct.pack("II", 0, 0)
+    msg(ctx, sock, VFIO_USER_DMA_UNMAP, payload,
+        expect=errno.EINVAL)
+
+
+def test_dma_unmap_bad_argsz():
+
+    payload = vfio_user_dma_unmap(argsz=8, flags=0, addr=0x1000, size=4096)
+    msg(ctx, sock, VFIO_USER_DMA_UNMAP, payload,
+        expect=errno.EINVAL)
