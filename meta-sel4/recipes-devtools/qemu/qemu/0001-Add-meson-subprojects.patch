+                           VFIO_IRQ_SET_DATA_NONE, index=VFU_DEV_NUM_IRQS,
+                           start=0, count=0)
+
+    msg(ctx, sock, VFIO_USER_DEVICE_SET_IRQS, payload,
+        expect=errno.EINVAL)
+
+
+def test_device_set_irqs_bad_flags_MASK_and_UNMASK():
