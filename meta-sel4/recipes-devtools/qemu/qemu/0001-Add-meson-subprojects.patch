index 0000000000000000000000000000000000000000..c8da8cbd1613f5c989ff686ef3e30a899fa25c82
--- /dev/null
+++ b/subprojects/slirp/src/tcp_var.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
