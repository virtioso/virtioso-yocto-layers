+
+    pub fn set_str(&mut self, name: &str, value: &str) -> Result<()> {
+        self.driver.set_str(name, value)
+    }
+
+    pub fn set_u64(&mut self, name: &str, value: u64) -> Result<()> {
+        self.driver.set_u64(name, value)
