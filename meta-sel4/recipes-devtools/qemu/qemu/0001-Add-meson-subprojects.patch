+
+    scale = 0;
+    while ( N < 0x8000 ) {
+        ++scale;
+        N <<= 1;
+    }
+    do {
+        z = random_ui32();
+    } while ( N <= z );
+    return z>>scale;
+
+}
+
+uint_fast64_t randomN_ui64( uint_fast64_t N )
+{
+    uint_fast64_t scale, z;
+
+    scale = 0;
