+
+    pub fn set_bool(&mut self, name: &str, value: bool) -> Result<()> {
+        self.driver.set_bool(name, value)
+    }
+
+    pub fn set_i32(&mut self, name: &str, value: i32) -> Result<()> {
+        self.driver.set_i32(name, value)
