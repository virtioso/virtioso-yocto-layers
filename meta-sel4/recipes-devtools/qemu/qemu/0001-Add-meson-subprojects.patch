diff --git a/subprojects/libblkio/tests/error-msg.c b/subprojects/libblkio/tests/error-msg.c
new file mode 100644
index 0000000000000000000000000000000000000000..d8e146040664247559306103a6f4aaae77204031
--- /dev/null
+++ b/subprojects/libblkio/tests/error-msg.c
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: (MIT OR Apache-2.0)
+#include <stdbool.h>
+#include <pthread.h>
+#include "util.h"
+
+static bool has_error_msg(void)
+{
+    return blkio_get_error_msg()[0] != '\0';
+}
+
+static void *thread_fn(void *arg) {
+    struct blkio *b;
+
+    assert(!has_error_msg());
+
+    err(blkio_create("foo", &b), -ENOENT);
+    assert(!b);
+
+    assert(has_error_msg());
+
+    return NULL;
+}
+
+/*
+ * Verify that error messages are thread-local.
+ */
+int main(void)
+{
+    pthread_t thread;
+
+    assert(!has_error_msg());
+
+    assert(pthread_create(&thread, NULL, thread_fn, NULL) == 0);
+    assert(pthread_join(thread, NULL) == 0);
+
+    assert(!has_error_msg());
+
+    return 0;
+}
