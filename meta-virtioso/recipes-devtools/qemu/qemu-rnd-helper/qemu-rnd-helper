#!/bin/sh

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    cat << EOF
Run QEMU as virtio device provider for seL4 VMs.

usage: $0 [-h|--help]
EOF
    exit 0
fi

# Hyp-ftrace guest stream bridge (best-effort, no-op if devmem is unavailable)
HYP_FTRACE_BASE=0x0F010000
HYP_FTRACE_CMD=$((HYP_FTRACE_BASE + 0x00))
VIO_TRACE_GUEST_REG_SOURCE_ID=$((HYP_FTRACE_BASE + 0x18))
VIO_TRACE_GUEST_REG_FLAGS=$((HYP_FTRACE_BASE + 0x1C))
VIO_TRACE_GUEST_REG_ARG0=$((HYP_FTRACE_BASE + 0x20))
VIO_TRACE_GUEST_REG_ARG1=$((HYP_FTRACE_BASE + 0x24))
VIO_TRACE_GUEST_REG_ARG2=$((HYP_FTRACE_BASE + 0x28))
VIO_TRACE_GUEST_REG_ARG3=$((HYP_FTRACE_BASE + 0x2C))
CMD_VIO_TRACE_GUEST_EMIT=0x20

# VM0 EL0 trace source/producer IDs and helper lifecycle events
VIO_TRACE_SRC_VM0_EL0=5
VIO_TRACE_PROD_VM0_QEMU_SEL4_ACCEL=5
VIO_TRACE_EV_VM0_QEMU_LAUNCH=26
VIO_TRACE_EV_VM0_QEMU_HEARTBEAT=27
VIO_TRACE_EV_VM0_QEMU_EXIT=28
VIO_TRACE_FLAGS_VM0_QEMU_LAUNCH=$(((VIO_TRACE_PROD_VM0_QEMU_SEL4_ACCEL << 8) | VIO_TRACE_EV_VM0_QEMU_LAUNCH))
VIO_TRACE_FLAGS_VM0_QEMU_HEARTBEAT=$(((VIO_TRACE_PROD_VM0_QEMU_SEL4_ACCEL << 8) | VIO_TRACE_EV_VM0_QEMU_HEARTBEAT))
VIO_TRACE_FLAGS_VM0_QEMU_EXIT=$(((VIO_TRACE_PROD_VM0_QEMU_SEL4_ACCEL << 8) | VIO_TRACE_EV_VM0_QEMU_EXIT))

vio_trace_write32() {
    addr="$1"
    value="$2"

    if command -v busybox >/dev/null 2>&1; then
        busybox devmem "$addr" 32 "$value" >/dev/null 2>&1 && return 0
        busybox devmem2 "$addr" w "$value" >/dev/null 2>&1 && return 0
    fi
    if command -v devmem2 >/dev/null 2>&1; then
        devmem2 "$addr" w "$value" >/dev/null 2>&1 && return 0
    fi
    if command -v devmem >/dev/null 2>&1; then
        devmem "$addr" 32 "$value" >/dev/null 2>&1 && return 0
    fi
    return 1
}

vio_trace_guest_emit() {
    source_id="$1"
    flags="${2:-0}"
    arg0="${3:-0}"
    arg1="${4:-0}"
    arg2="${5:-0}"
    arg3="${6:-0}"

    vio_trace_write32 "$VIO_TRACE_GUEST_REG_SOURCE_ID" "$source_id" || return 0
    vio_trace_write32 "$VIO_TRACE_GUEST_REG_FLAGS" "$flags" || return 0
    vio_trace_write32 "$VIO_TRACE_GUEST_REG_ARG0" "$arg0" || return 0
    vio_trace_write32 "$VIO_TRACE_GUEST_REG_ARG1" "$arg1" || return 0
    vio_trace_write32 "$VIO_TRACE_GUEST_REG_ARG2" "$arg2" || return 0
    vio_trace_write32 "$VIO_TRACE_GUEST_REG_ARG3" "$arg3" || return 0
    vio_trace_write32 "$HYP_FTRACE_CMD" "$CMD_VIO_TRACE_GUEST_EMIT" || return 0

    return 0
}

vio_trace_ready() {
    if grep '^vio_trace ' /proc/modules >/dev/null 2>&1; then
        return 0
    fi
    if [ -c /dev/vio_trace ]; then
        return 0
    fi
    if [ -d /sys/bus/platform/drivers/vio_trace ]; then
        return 0
    fi
    return 1
}

if test "x${VMID}" = "x"; then
    VMID=1
    echo "VMID not specified, defaulting to ${VMID}"
fi

export VMID

# rootfs for guest
GUEST_IMG="${GUEST_IMG:-/var/lib/virt/images/user-vm.qcow2}"
# directory shared to guest
GUEST_SHARED="${GUEST_SHARED:-$HOME/.local/share/virt/shared}"
mkdir -p "$GUEST_SHARED"

GUEST_GUI_ARGS="${GUEST_GUI_ARGS:--vga none -display none}"
GUEST_NET_ARGS=""
GUEST_VIRTIO_ARGS=""
SEL4_DIRECT_DELEGATION="${SEL4_DIRECT_DELEGATION:-1}"

# Additional arguments for net device e.g. ",vhost=yes"
GUEST_NET_ARGS_APPEND="${GUEST_NET_ARGS_APPEND:-}"

# Additional device arguments e.g. ",bus=pcie.0"
GUEST_DEV_ARGS_APPEND="${GUEST_DEV_ARGS_APPEND:-}"

case "${VMID}" in
    1)
        GUEST_NET_ARGS="${GUEST_NET_ARGS} -netdev tap,id=net0,ifname=tap0,script=no,downscript=no${GUEST_NET_ARGS_APPEND}"
        GUEST_NET_ARGS="${GUEST_NET_ARGS} -device virtio-net-pci,romfile=,netdev=net0,mac=02:ca:fe:f0:0d:01,disable-legacy=on${GUEST_DEV_ARGS_APPEND}"
        echo "Guest using tap0 for network"
        ;;
    2)
        GUEST_NET_ARGS="${GUEST_NET_ARGS} -netdev tap,id=net1,ifname=tap1,script=no,downscript=no${GUEST_NET_ARGS_APPEND}"
        GUEST_NET_ARGS="${GUEST_NET_ARGS} -device virtio-net-pci,romfile=,netdev=net1,mac=02:ca:fe:f0:0d:02,disable-legacy=on${GUEST_DEV_ARGS_APPEND}"
        echo "Guest using tap1 for network"
        ;;
    *)
        echo "Guest networking disabled"
        ;;
esac

QEMU_APPEND_BOOTARGS=""
QEMU_EXTRA_ARGS="${GUEST_GUI_ARGS} ${GUEST_NET_ARGS}"
QEMU_EXTRA_ARGS="${QEMU_EXTRA_ARGS} ${GUEST_VIRTIO_ARGS}"

# Decode args like 'uservm=1,0x48000000,0x10000000,0x60000000,0x10000000'
# TODO: use device tree
GUEST_MEMSZ=`while read -d' ' p; do
    echo $p | grep '^uservm='${VMID}',' | cut -f3 -d, | xargs -Isz printf "%d" sz
done < /proc/cmdline`

if test -n "${GUEST_MEMSZ}"; then
    # using seL4
    GUEST_MEMSZ=`expr ${GUEST_MEMSZ} / 1048576`
    ACCEL=sel4
fi
GUEST_MEMSZ=${GUEST_MEMSZ:-256}

if test "x${ACCEL}" = "xsel4"; then
    if [ "$SEL4_DIRECT_DELEGATION" = "1" ]; then
        if [ -d /sys/module/sel4_virt ]; then
            echo 1 > /sys/module/sel4_virt/parameters/direct_delegation
        else
            modprobe sel4_virt direct_delegation=1
        fi
        echo "sel4 direct delegation enabled"
    else
        modprobe sel4_virt
    fi
    if vio_trace_ready; then
        echo "vio_trace ready"
    else
        echo "ERROR: vio_trace not ready"
        exit 1
    fi
else
    # using something else, let's default to KVM
    QEMU_APPEND_BOOTARGS="${QEMU_APPEND_BOOTARGS} console=hvc0 root=/dev/vda"
    QEMU_EXTRA_ARGS="${QEMU_EXTRA_ARGS} -kernel /boot/Image -cpu host"
    ACCEL=kvm
fi

ulimit -c unlimited

VMTMPDIR=/tmp/vm${VMID}
mkdir -p ${VMTMPDIR}

ROOTFS_STORAGE=${ROOTFS_STORAGE:-tmpfs}
case "${ROOTFS_STORAGE}" in
    tmpfs)
        cp ${GUEST_IMG} ${VMTMPDIR}
        GUEST_IMG=${VMTMPDIR}/`basename ${GUEST_IMG}`
        echo "Guest rootfs: using volatile rootfs cached in host tmpfs" 1>&2
        ;;
    extra_ramdisk)
        qemu-img create -f raw ${VMTMPDIR}/ramdisk.raw 128M
        mke2fs ${VMTMPDIR}/ramdisk.raw
        QEMU_EXTRA_ARGS="${QEMU_EXTRA_ARGS} -device virtio-blk-pci,drive=drive1,id=virtblk1,disable-legacy=on${GUEST_DEV_ARGS_APPEND}"
        QEMU_EXTRA_ARGS="${QEMU_EXTRA_ARGS} -drive format=raw,file="${VMTMPDIR}"/ramdisk.raw,if=none,id=drive1"
        echo "Guest rootfs: using host permanent storage at ${GUEST_IMG}" 1>&2
        echo "Providing additional volatile 128 MB /dev/vdb to guest" 1>&2
        ;;
    host)
        echo "Guest rootfs: using host permanent storage at ${GUEST_IMG}" 1>&2
        ;;
    *)
        echo "Unknown storage class for guest rootfs" 1>&2
        exit 1
        ;;
esac

heartbeat_pid=""
qemu_pid=""

cleanup_bridge() {
    if [ -n "$heartbeat_pid" ]; then
        kill "$heartbeat_pid" >/dev/null 2>&1 || true
        wait "$heartbeat_pid" >/dev/null 2>&1 || true
        heartbeat_pid=""
    fi
}
trap cleanup_bridge EXIT INT TERM

ensure_sel4_bridge_dev() {
    major=""
    if [ -c /dev/sel4 ] && [ -r /dev/sel4 ] && [ -w /dev/sel4 ]; then
        return 0
    fi

    minor="$(awk '$2 == "sel4" { print $1; exit }' /proc/misc 2>/dev/null)"
    if [ -n "$minor" ]; then
        if [ ! -e /dev/sel4 ]; then
            mknod /dev/sel4 c 10 "$minor" >/dev/null 2>&1 || true
        fi
        chmod 0660 /dev/sel4 >/dev/null 2>&1 || true
    fi

    if [ -z "$minor" ]; then
        major="$(awk '$2 == "sel4" { print $1; exit }' /proc/devices 2>/dev/null)"
        if [ -n "$major" ]; then
            if [ ! -e /dev/sel4 ]; then
                mknod /dev/sel4 c "$major" 0 >/dev/null 2>&1 || true
            fi
            chmod 0660 /dev/sel4 >/dev/null 2>&1 || true
        fi
    fi

    [ -c /dev/sel4 ] && [ -r /dev/sel4 ] && [ -w /dev/sel4 ]
}

vio_trace_diag_dump() {
    misc_line="$(awk '$2 == "sel4" { print; exit }' /proc/misc 2>/dev/null)"
    if [ -n "$misc_line" ]; then
        echo "VIO_TRACE_DIAG: /proc/misc sel4: $misc_line"
    else
        echo "VIO_TRACE_DIAG: /proc/misc sel4: missing"
    fi

    devices_line="$(awk '$2 == "sel4" { print; exit }' /proc/devices 2>/dev/null)"
    if [ -n "$devices_line" ]; then
        echo "VIO_TRACE_DIAG: /proc/devices sel4: $devices_line"
    else
        echo "VIO_TRACE_DIAG: /proc/devices sel4: missing"
    fi

    if [ -e /dev/sel4 ]; then
        ls -l /dev/sel4 | sed 's/^/VIO_TRACE_DIAG: /'
    else
        echo "VIO_TRACE_DIAG: /dev/sel4 missing"
    fi

    if [ -d /sys/class/misc/sel4 ]; then
        echo "VIO_TRACE_DIAG: /sys/class/misc/sel4 present"
    else
        echo "VIO_TRACE_DIAG: /sys/class/misc/sel4 missing"
    fi

    if [ -d /sys/module/vio_trace ]; then
        echo "VIO_TRACE_DIAG: /sys/module/vio_trace present"
    else
        echo "VIO_TRACE_DIAG: /sys/module/vio_trace missing"
    fi

    if [ -d /sys/module/sel4_virt ]; then
        echo "VIO_TRACE_DIAG: /sys/module/sel4_virt present"
    else
        echo "VIO_TRACE_DIAG: /sys/module/sel4_virt missing"
    fi

    echo "VIO_TRACE_DIAG: legacy sel4_tracebuffer node paths are retired; canonical bridge path is /dev/sel4"
}

sel4_bridge_wait_s="${VIO_TRACE_BRIDGE_WAIT_SEC:-10}"
while [ "$sel4_bridge_wait_s" -gt 0 ]; do
    if ensure_sel4_bridge_dev; then
        echo "VIO_TRACE_DIAG: /dev/sel4 bridge ready"
        vio_trace_diag_dump
        break
    fi
    sleep 1
    sel4_bridge_wait_s=$((sel4_bridge_wait_s - 1))
done

if [ "$sel4_bridge_wait_s" -eq 0 ]; then
    echo "VIO_TRACE_DIAG: /dev/sel4 bridge unavailable after wait"
    vio_trace_diag_dump
fi

/usr/bin/qemu-system-aarch64 \
    `# minicom already uses ^A, change monitor escape to ^T` \
    -echr 0x14 \
    `# do not touch these` \
    --accel ${ACCEL} \
    -M virt \
    -m ${GUEST_MEMSZ}m \
    `# virtio-blk device for guest rootfs` \
    -device virtio-blk-pci,drive=drive0,id=virtblk0,disable-legacy=on${GUEST_DEV_ARGS_APPEND} \
    -drive format=qcow2,file=${GUEST_IMG},if=none,id=drive0 \
    `# share directory to guest over 9P` \
    -virtfs local,path=${GUEST_SHARED},mount_tag=shared,security_model=mapped-xattr \
    `# debug messages, use monitor to read them` \
    -chardev ringbuf,id=debug,size=64K \
    `# enable multiplexer on stdio to have both guest and monitor` \
    -chardev stdio,id=mon,mux=on,signal=off \
    `# enable monitor` \
    -mon chardev=mon,mode=readline \
    `# no serial, emulating pl011 @ 0x09000000 in seL4 code` \
    -serial none \
    `# extra options` \
    ${QEMU_EXTRA_ARGS} \
    ${QEMU_APPEND_BOOTARGS:+-append "${QEMU_APPEND_BOOTARGS}"} \
    `# that's it!` &
qemu_pid="$!"

vio_trace_guest_emit "$VIO_TRACE_SRC_VM0_EL0" "$VIO_TRACE_FLAGS_VM0_QEMU_LAUNCH" "$VMID" 0 0 0

if [ "${VIO_TRACE_VM1_BRIDGE:-1}" = "1" ]; then
    (
        seq=0
        hb_sec="${VIO_TRACE_VM1_HEARTBEAT_SEC:-2}"
        while kill -0 "$qemu_pid" >/dev/null 2>&1; do
            sleep "$hb_sec"
            seq=$((seq + 1))
            vio_trace_guest_emit "$VIO_TRACE_SRC_VM0_EL0" "$VIO_TRACE_FLAGS_VM0_QEMU_HEARTBEAT" "$VMID" "$seq" 0 0
        done
    ) &
    heartbeat_pid="$!"
fi

wait "$qemu_pid"
qemu_rc="$?"
cleanup_bridge
vio_trace_guest_emit "$VIO_TRACE_SRC_VM0_EL0" "$VIO_TRACE_FLAGS_VM0_QEMU_EXIT" "$VMID" "$qemu_rc" 0 0
exit "$qemu_rc"
