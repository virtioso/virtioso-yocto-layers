#!/bin/sh
# udhcpc default script for minimal init

[ -z "$1" ] && echo "Error: should be called from udhcpc" && exit 1

RESOLV_CONF="/etc/resolv.conf"

case "$1" in
    deconfig)
        /sbin/ip addr flush dev $interface
        /sbin/ip link set $interface up
        ;;

    renew|bound)
        /sbin/ip addr add $ip/$mask dev $interface

        if [ -n "$router" ]; then
            /sbin/ip route add default via $router dev $interface
        fi

        if [ -n "$dns" ]; then
            echo -n > $RESOLV_CONF
            for ns in $dns; do
                echo "nameserver $ns" >> $RESOLV_CONF
            done
        fi

        echo "DHCP: $interface configured with $ip/$mask"
        [ -n "$router" ] && echo "DHCP: gateway $router"
        ;;
esac

exit 0
