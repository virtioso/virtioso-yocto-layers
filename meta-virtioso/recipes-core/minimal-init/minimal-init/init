#!/bin/sh
#
# Minimal init for seL4 VM testing
# Mounts essential filesystems and starts an interactive shell
#

echo "=== seL4 VM Minimal Init ==="

# Mount essential filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# Create device nodes if devtmpfs not available
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null ]    || mknod -m 666 /dev/null c 1 3
[ -e /dev/tty ]     || mknod -m 666 /dev/tty c 5 0
[ -e /dev/tty0 ]    || mknod -m 444 /dev/tty0 c 4 0
[ -e /dev/ttyAMA0 ] || mknod -m 666 /dev/ttyAMA0 c 204 64
[ -e /dev/ptmx ]    || mknod -m 666 /dev/ptmx c 5 2

# Set up pseudo-terminal support
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null

# Set hostname
hostname sel4-vm

echo ""
echo "=== seL4 VM Boot Complete ==="
echo "Kernel: $(uname -r)"
echo "Cmdline: $(cat /proc/cmdline)"
echo ""
echo "Starting shell on console..."

# Start interactive shell on the console device
exec /bin/sh </dev/console >/dev/console 2>&1
