#!/bin/sh
#
# Unified init for seL4 VM with NFS primary, eMMC fallback
#
# Boot sequence:
# 1. Mount essential filesystems
# 2. Detect platform (orinagx/rpi4/qemu)
# 3. Load platform-specific drivers
# 4. Set up TAP bridge (br0, tap0, tap1)
# 5. Try NFS boot (DHCP + NFS mount)
# 6. If NFS fails, try eMMC/loop mount
# 7. If all fails, drop to shell
#

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Configurable defaults (can override via cmdline)
ROOTFS_IMAGE="${ROOTFS_IMAGE:-var/lib/virtioso-vm-images/vm-image-driver-vm-jetson-agx-orin.rootfs.ext4}"
EMMC_PART="/dev/mmcblk0p1"
DROP_TO_SHELL=""
PLATFORM="qemu"

#############################################################################
# Functions
#############################################################################

mount_essential_filesystems() {
    echo "Mounting essential filesystems..."
    mkdir -p /proc /sys /dev /tmp /run /newroot /mnt/emmc

    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
    mount -t tmpfs tmpfs /tmp
    mount -t tmpfs tmpfs /run

    # Create device nodes if devtmpfs not available
    [ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
    [ -e /dev/null ]    || mknod -m 666 /dev/null c 1 3
    [ -e /dev/tty ]     || mknod -m 666 /dev/tty c 5 0

    # Set up pseudo-terminal support
    mkdir -p /dev/pts
    mount -t devpts devpts /dev/pts 2>/dev/null

    # Create loop device nodes (busybox losetup needs these)
    for i in 0 1 2 3 4 5 6 7; do
        [ -e /dev/loop$i ] || mknod -m 660 /dev/loop$i b 7 $i
    done
}

parse_cmdline() {
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            rootfs_image=*) ROOTFS_IMAGE="${arg#rootfs_image=}" ;;
            emmc_part=*)    EMMC_PART="${arg#emmc_part=}" ;;
            shell)          DROP_TO_SHELL=1 ;;
        esac
    done
}

detect_platform() {
    PLATFORM="qemu"  # Default

    if [ -f /proc/device-tree/compatible ]; then
        # Device tree compatible strings are null-separated
        compat=$(cat /proc/device-tree/compatible 2>/dev/null | tr '\0' '\n')
        echo "Device tree compatible: $compat"

        if echo "$compat" | grep -q "nvidia,jetson-agx-orin"; then
            PLATFORM="orinagx"
        elif echo "$compat" | grep -q "nvidia,tegra"; then
            PLATFORM="orinagx"  # Other Tegra platforms
        elif echo "$compat" | grep -q "raspberrypi"; then
            PLATFORM="rpi4"
        fi
    fi

    echo "Detected platform: $PLATFORM"
}

load_platform_drivers() {
    echo "Loading platform drivers for $PLATFORM..."

    case "$PLATFORM" in
        orinagx)
            # CRITICAL: pmc-irq-domain MUST load first!
            # It's a dummy driver that competes with real PMC for the same DT node.
            # GPIO driver defers probe until PMC IRQ domain exists.
            echo "Loading pmc-irq-domain (MUST be first - beats real PMC to DT node)..."
            modprobe pmc-irq-domain || echo "modprobe pmc-irq-domain failed (may be OK if no PMC node)"

            # BPMP driver - other drivers depend on it for clocks/resets
            echo "Loading tegra_bpmp..."
            modprobe tegra_bpmp || echo "modprobe tegra_bpmp failed"

            # Ethernet stack
            echo "Loading Ethernet drivers..."
            modprobe phy-tegra194-p2u || echo "modprobe phy-tegra194-p2u failed"
            modprobe nvpps || echo "modprobe nvpps failed"
            modprobe nvethernet || echo "modprobe nvethernet failed"
            ;;
        rpi4)
            # RPi4-specific drivers if needed
            ;;
        qemu)
            # QEMU virtio drivers auto-load
            ;;
    esac

    # Common: TUN module for TAP devices
    echo "Loading TUN module..."
    modprobe tun || echo "modprobe tun failed"
}

wait_for_ethernet() {
    echo "Waiting for eth0..."
    count=0
    while [ ! -e /sys/class/net/eth0 ] && [ $count -lt 50 ]; do
        sleep 0.1
        count=$((count + 1))
    done

    if [ -e /sys/class/net/eth0 ]; then
        echo "eth0 found"
        return 0
    else
        echo "eth0 not found after 5 seconds"
        return 1
    fi
}

setup_tap_bridge() {
    echo "Setting up TAP bridge..."

    # Create bridge
    brctl addbr br0
    ip addr flush dev eth0
    brctl addif br0 eth0

    # Create TAP devices for VM-to-VM communication
    tunctl -t tap0 -u 0
    tunctl -t tap1 -u 0
    brctl addif br0 tap0
    brctl addif br0 tap1

    # Bring up interfaces
    ip link set eth0 up
    ip link set tap0 up
    ip link set tap1 up
    ip link set br0 up

    echo "Bridge br0 configured with eth0, tap0, tap1"
}

try_nfs_boot() {
    echo "=== Attempting NFS boot ==="

    # Create udhcpc script to capture DHCP response
    # Use -s option to specify script directly (busybox default.script may not exist)
    cat > /tmp/udhcpc-script <<'EOF'
#!/bin/sh
# Save all DHCP variables to file
env > /udhcpc.env
# Also configure the interface (minimal implementation)
case "$1" in
    bound|renew)
        [ -n "$ip" ] && ip addr add "$ip/${mask:-24}" dev "$interface" 2>/dev/null
        [ -n "$router" ] && ip route add default via "$router" dev "$interface" 2>/dev/null
        ;;
esac
EOF
    chmod 755 /tmp/udhcpc-script

    # Try DHCP on bridge interface
    echo "Running DHCP on br0..."
    if ! udhcpc -i br0 -s /tmp/udhcpc-script -O rootpath -n -q -t 5; then
        echo "DHCP failed or timed out"
        return 1
    fi

    if [ ! -f /udhcpc.env ]; then
        echo "No DHCP response captured"
        return 1
    fi

    # Extract rootpath from DHCP response
    eval "$(grep rootpath= /udhcpc.env 2>/dev/null)"
    if [ -z "$rootpath" ]; then
        echo "No NFS rootpath from DHCP"
        return 1
    fi

    # Parse NFS path and options
    rootflags=$(echo "${rootpath}" | cut -d, -f2-)
    root=$(echo "${rootpath}" | cut -d, -f1)

    echo "NFS root: $root"
    echo "NFS options: $rootflags"

    # Mount NFS root
    if ! mount -t nfs -o"$rootflags" "$root" /newroot; then
        echo "NFS mount failed: $root"
        return 1
    fi

    echo "NFS boot successful"
    return 0
}

try_emmc_boot() {
    echo "=== Attempting eMMC fallback ==="

    # Wait for eMMC
    echo "Waiting for eMMC (mmcblk0)..."
    count=0
    while [ ! -b /dev/mmcblk0 ] && [ $count -lt 50 ]; do
        sleep 0.1
        count=$((count + 1))
    done

    if [ ! -b /dev/mmcblk0 ]; then
        echo "eMMC not found after 5 seconds"
        return 1
    fi

    echo "eMMC detected: $(cat /sys/block/mmcblk0/device/name 2>/dev/null || echo 'unknown')"

    # Wait for partition
    echo "Waiting for ${EMMC_PART}..."
    count=0
    while [ ! -b "$EMMC_PART" ] && [ $count -lt 30 ]; do
        sleep 0.1
        count=$((count + 1))
    done

    if [ ! -b "$EMMC_PART" ]; then
        echo "eMMC partition not found: $EMMC_PART"
        ls -la /dev/mmcblk0* 2>/dev/null
        return 1
    fi

    # Mount eMMC partition
    echo "Mounting ${EMMC_PART}..."
    if ! mount -o rw "$EMMC_PART" /mnt/emmc; then
        echo "Failed to mount eMMC"
        return 1
    fi

    # Find rootfs image
    ROOTFS_PATH="/mnt/emmc/${ROOTFS_IMAGE}"
    echo "Looking for rootfs image: ${ROOTFS_PATH}"

    if [ ! -f "$ROOTFS_PATH" ]; then
        echo "Rootfs image not found: ${ROOTFS_PATH}"
        echo "Files in /mnt/emmc:"
        ls -la /mnt/emmc/*.ext4 2>/dev/null || ls -la /mnt/emmc | head -n 20
        return 1
    fi

    ROOTFS_SIZE=$(ls -lh "$ROOTFS_PATH" | awk '{print $5}')
    echo "Found rootfs image: ${ROOTFS_IMAGE} (${ROOTFS_SIZE})"

    # Set up loop device
    echo "Setting up loop device..."
    LOOP_DEV=$(losetup -f)
    if [ -z "$LOOP_DEV" ]; then
        echo "No free loop device"
        return 1
    fi

    if ! losetup "$LOOP_DEV" "$ROOTFS_PATH"; then
        echo "Loop device setup failed"
        return 1
    fi

    echo "Loop device: ${LOOP_DEV}"

    # Mount rootfs
    echo "Mounting rootfs..."
    if ! mount -o rw "$LOOP_DEV" /newroot; then
        echo "Loop mount failed"
        losetup -d "$LOOP_DEV"
        return 1
    fi

    echo "eMMC boot successful"
    return 0
}

verify_init() {
    # Verify the rootfs has /sbin/init
    INIT_PATH="/sbin/init"
    INIT_CHECK="/newroot${INIT_PATH}"

    # If it's a symlink, resolve it relative to the rootfs
    if [ -L "$INIT_CHECK" ]; then
        LINK_TARGET=$(readlink "$INIT_CHECK")
        case "$LINK_TARGET" in
            /*) INIT_CHECK="/newroot${LINK_TARGET}" ;;
            *)  INIT_CHECK="/newroot/sbin/${LINK_TARGET}" ;;
        esac
    fi

    if [ ! -x "$INIT_CHECK" ]; then
        echo "WARNING: /sbin/init not found or not executable"
        if [ -x "/newroot/init" ]; then
            echo "Found /init, will use that instead"
            INIT_PATH="/init"
        else
            echo "ERROR: No init found in rootfs"
            return 1
        fi
    fi

    echo "Init verified: ${INIT_PATH}"
    return 0
}

do_switch_root() {
    echo ""
    echo "=== Switching to rootfs ==="
    echo "Init: ${INIT_PATH}"
    echo ""

    # Move virtual filesystems to new root
    mount --move /sys  /newroot/sys  2>/dev/null || mount -t sysfs sysfs /newroot/sys
    mount --move /proc /newroot/proc 2>/dev/null || mount -t proc proc /newroot/proc
    mount --move /dev  /newroot/dev  2>/dev/null || mount -t devtmpfs devtmpfs /newroot/dev

    exec switch_root /newroot "$INIT_PATH"

    # If switch_root fails
    echo "ERROR: switch_root failed!"
    return 1
}

drop_to_shell() {
    echo ""
    echo "=== Dropping to shell for debugging ==="
    echo "Commands: ip addr, mount, dmesg, cat /proc/cmdline"
    echo ""
    exec /bin/sh
}

#############################################################################
# Main
#############################################################################

echo "=== seL4 VM Unified Init ==="

# Phase 1: Essential setup
mount_essential_filesystems

echo "Kernel: $(uname -r)"
echo "Cmdline: $(cat /proc/cmdline)"

parse_cmdline

# Check if we should just drop to shell (for debugging)
if [ -n "$DROP_TO_SHELL" ]; then
    echo "'shell' requested on cmdline"
    drop_to_shell
fi

# Phase 2: Platform detection
detect_platform

# Phase 3: Load drivers
load_platform_drivers

# Phase 4: Network setup
wait_for_ethernet
setup_tap_bridge

# Phase 5: Boot - try NFS first, then eMMC fallback
INIT_PATH="/sbin/init"

if try_nfs_boot; then
    echo "NFS boot succeeded"
elif try_emmc_boot; then
    echo "eMMC boot succeeded"
else
    echo "All boot methods failed"
    drop_to_shell
fi

# Verify init exists
if ! verify_init; then
    drop_to_shell
fi

# Phase 6: Switch to real rootfs
do_switch_root

# Should never reach here
drop_to_shell
