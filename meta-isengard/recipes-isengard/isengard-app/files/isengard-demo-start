#!/bin/sh
# isengard-demo-start: set up vcan0 and launch the Isengard pipeline
#
# Pipeline:
#   cangen vcan0 -> [vcan0] -> isengard_app -> snapshot region
#                                            -> isengard_objfs /obj
#                                               -> isengard-demo-watch

set -e

# vcan0
modprobe vcan 2>/dev/null || true
ip link add dev vcan0 type vcan 2>/dev/null || true
ip link set vcan0 up
echo "vcan0 up"

# CANopenNODE service + isengard-core
isengard_app vcan0 &
sleep 0.3

# FUSE snapshot object tree
mkdir -p /obj
isengard_objfs /obj &
sleep 0.3

# CAN traffic generator (10 ms inter-frame gap)
cangen vcan0 -g 10 &

echo ""
echo "Isengard demo running on vcan0."
echo "  candump vcan0          -- raw CAN traffic"
echo "  isengard-demo-watch    -- live semantic state dashboard"
echo "  cat /obj/isengard/...  -- individual snapshot objects"
echo ""
