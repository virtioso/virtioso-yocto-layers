#!/bin/sh
#
# Isengard initramfs init: loop-mount rootfs from stock Jetson Linux eMMC
#
# Boot sequence:
# 1. Mount essential filesystems
# 2. Wait for eMMC
# 3. Mount stock Linux root partition
# 4. Loop-mount isengard rootfs ext4 image
# 5. switch_root
#

PATH=/sbin:/bin:/usr/sbin:/usr/bin

DEFAULT_ROOTFS_IMAGE="@DEFAULT_ROOTFS_IMAGE@"
ROOTFS_IMAGE="${ROOTFS_IMAGE:-$DEFAULT_ROOTFS_IMAGE}"
EMMC_PART="/dev/mmcblk0p1"
DROP_TO_SHELL=""

mount_essential_filesystems() {
    mkdir -p /proc /sys /dev /tmp /run /newroot /mnt/emmc

    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
    mount -t tmpfs tmpfs /tmp
    mount -t tmpfs tmpfs /run

    [ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
    [ -e /dev/null ]    || mknod -m 666 /dev/null c 1 3
    [ -e /dev/tty ]     || mknod -m 666 /dev/tty c 5 0

    mkdir -p /dev/pts
    mount -t devpts devpts /dev/pts 2>/dev/null

    for i in 0 1 2 3 4 5 6 7; do
        [ -e /dev/loop$i ] || mknod -m 660 /dev/loop$i b 7 $i
    done
}

parse_cmdline() {
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            rootfs_image=*) ROOTFS_IMAGE="${arg#rootfs_image=}" ;;
            emmc_part=*)    EMMC_PART="${arg#emmc_part=}" ;;
            shell)          DROP_TO_SHELL=1 ;;
        esac
    done
}

wait_for_block_device() {
    dev_path="$1"
    timeout_ticks="${2:-50}"
    count=0
    while [ ! -b "$dev_path" ] && [ $count -lt "$timeout_ticks" ]; do
        sleep 0.1
        count=$((count + 1))
    done
    [ -b "$dev_path" ]
}

drop_to_shell() {
    echo ""
    echo "=== Dropping to shell for debugging ==="
    echo "Cmdline: $(cat /proc/cmdline)"
    exec /bin/sh
}

#############################################################################
# Main
#############################################################################

echo "=== Isengard initramfs init ==="

mount_essential_filesystems

echo "Kernel: $(uname -r)"
echo "Cmdline: $(cat /proc/cmdline)"

parse_cmdline

if [ -n "$DROP_TO_SHELL" ]; then
    drop_to_shell
fi

# Wait for eMMC
echo "Waiting for eMMC..."
if ! wait_for_block_device /dev/mmcblk0 100; then
    echo "ERROR: eMMC (mmcblk0) not found"
    drop_to_shell
fi

echo "Waiting for ${EMMC_PART}..."
if ! wait_for_block_device "$EMMC_PART" 50; then
    echo "ERROR: Partition ${EMMC_PART} not found"
    ls -la /dev/mmcblk0* 2>/dev/null
    drop_to_shell
fi

# Mount stock Linux root partition read-only
echo "Mounting stock Linux root: ${EMMC_PART}"
if ! mount -o ro "$EMMC_PART" /mnt/emmc; then
    echo "ERROR: Failed to mount ${EMMC_PART}"
    drop_to_shell
fi

# Find isengard rootfs image
ROOTFS_PATH="/mnt/emmc/${ROOTFS_IMAGE}"
echo "Looking for rootfs image: ${ROOTFS_PATH}"

if [ ! -f "$ROOTFS_PATH" ]; then
    echo "ERROR: Rootfs image not found: ${ROOTFS_PATH}"
    echo "Files in expected directory:"
    ls -la "/mnt/emmc/$(dirname "$ROOTFS_IMAGE")/" 2>/dev/null || \
        ls -la /mnt/emmc/ | head -n 20
    drop_to_shell
fi

echo "Found rootfs image: $(ls -lh "$ROOTFS_PATH" | awk '{print $5}')"

# Loop-mount isengard rootfs
LOOP_DEV=$(losetup -f)
if [ -z "$LOOP_DEV" ]; then
    echo "ERROR: No free loop device"
    drop_to_shell
fi

echo "Setting up ${LOOP_DEV} -> ${ROOTFS_PATH}"
if ! losetup "$LOOP_DEV" "$ROOTFS_PATH"; then
    echo "ERROR: losetup failed"
    drop_to_shell
fi

echo "Mounting rootfs..."
if ! mount -o rw "$LOOP_DEV" /newroot; then
    echo "ERROR: Failed to mount rootfs loop device"
    losetup -d "$LOOP_DEV"
    drop_to_shell
fi

# Verify init
if [ ! -x /newroot/sbin/init ] && [ ! -x /newroot/init ]; then
    echo "ERROR: No executable init found in rootfs"
    drop_to_shell
fi

INIT_PATH="/sbin/init"
[ -x /newroot/sbin/init ] || INIT_PATH="/init"

echo "Switching to isengard rootfs (init: ${INIT_PATH})"

mount --move /sys  /newroot/sys  2>/dev/null || mount -t sysfs sysfs /newroot/sys
mount --move /proc /newroot/proc 2>/dev/null || mount -t proc proc /newroot/proc
mount --move /dev  /newroot/dev  2>/dev/null || mount -t devtmpfs devtmpfs /newroot/dev

exec switch_root /newroot "$INIT_PATH"

echo "ERROR: switch_root failed!"
drop_to_shell
